# Kanflow-Brand — Environment Variables
# Copy this file to apps/server/.env and fill in real values.
# Never commit real secrets to version control.

# =============================================================================
# apps/server
# =============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/kanflow

# URL of the web app — used for CORS allowlist (must match apps/web origin exactly)
CORS_ORIGIN=http://localhost:3000

# Node environment: development | production | test
NODE_ENV=development

# Secret used to sign JWTs — generate with: openssl rand -base64 64
# Minimum 32 characters required.
JWT_SECRET=replace-me-with-a-strong-random-secret-at-least-32-chars

# How long JWT tokens stay valid (e.g. 7d, 24h, 3600)
JWT_EXPIRES_IN=7d

# =============================================================================
# apps/web
# =============================================================================

# URL of the NestJS API server — must match CORS_ORIGIN above
NEXT_PUBLIC_SERVER_URL=http://localhost:5000
